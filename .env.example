# Copy to .env on the EC2 box and fill in real values:  cp .env.example .env
# docker compose reads .env automatically. Never commit the filled-in .env.

# --- database ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DB_NAME=hotel_db
MYSQL_USERNAME=appuser
MYSQL_PASSWORD=change-me-app

# --- app --------------------------------------------------------------------
# Host port the API is published on. Use 80 to serve it without a port suffix.
APP_PORT=8080

# --- razorpay ---------------------------------------------------------------
RAZORPAY_KEY=
RAZORPAY_SECRET=

# --- mail -------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASS=
SENDTO_EMAIL=
